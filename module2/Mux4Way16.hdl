CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];

    PARTS:
    // Precompute NOTs
    Nand(a=sel[0], b=sel[0], out=sel0);
    Nand(a=sel[1], b=sel[1], out=sel1);

    // bit 0
    Nand(a=sel0, b=a[0], out=sel0a0);
    Nand(a=sel[0], b=b[0], out=sel0b0);
    Nand(a=sel0a0, b=sel0b0, out=outSel0ab0);

    Nand(a=sel0, b=c[0], out=sel0c0);
    Nand(a=sel[0], b=d[0], out=sel0d0);
    Nand(a=sel0c0, b=sel0d0, out=outSel0cd0);

    Nand(a=sel1, b=outSel0ab0, out=sel1ab0);
    Nand(a=sel[1], b=outSel0cd0, out=sel1cd0);
    Nand(a=sel1ab0, b=sel1cd0, out=out[0]);

    // bit 1
    Nand(a=sel0, b=a[1], out=sel0a1);
    Nand(a=sel[0], b=b[1], out=sel0b1);
    Nand(a=sel0a1, b=sel0b1, out=outSel0ab1);

    Nand(a=sel0, b=c[1], out=sel0c1);
    Nand(a=sel[0], b=d[1], out=sel0d1);
    Nand(a=sel0c1, b=sel0d1, out=outSel0cd1);

    Nand(a=sel1, b=outSel0ab1, out=sel1ab1);
    Nand(a=sel[1], b=outSel0cd1, out=sel1cd1);
    Nand(a=sel1ab1, b=sel1cd1, out=out[1]);

    // bit 2
    Nand(a=sel0, b=a[2], out=sel0a2);
    Nand(a=sel[0], b=b[2], out=sel0b2);
    Nand(a=sel0a2, b=sel0b2, out=outSel0ab2);

    Nand(a=sel0, b=c[2], out=sel0c2);
    Nand(a=sel[0], b=d[2], out=sel0d2);
    Nand(a=sel0c2, b=sel0d2, out=outSel0cd2);

    Nand(a=sel1, b=outSel0ab2, out=sel1ab2);
    Nand(a=sel[1], b=outSel0cd2, out=sel1cd2);
    Nand(a=sel1ab2, b=sel1cd2, out=out[2]);

    // bit 3
    Nand(a=sel0, b=a[3], out=sel0a3);
    Nand(a=sel[0], b=b[3], out=sel0b3);
    Nand(a=sel0a3, b=sel0b3, out=outSel0ab3);

    Nand(a=sel0, b=c[3], out=sel0c3);
    Nand(a=sel[0], b=d[3], out=sel0d3);
    Nand(a=sel0c3, b=sel0d3, out=outSel0cd3);

    Nand(a=sel1, b=outSel0ab3, out=sel1ab3);
    Nand(a=sel[1], b=outSel0cd3, out=sel1cd3);
    Nand(a=sel1ab3, b=sel1cd3, out=out[3]);

    // bit 4
    Nand(a=sel0, b=a[4], out=sel0a4);
    Nand(a=sel[0], b=b[4], out=sel0b4);
    Nand(a=sel0a4, b=sel0b4, out=outSel0ab4);

    Nand(a=sel0, b=c[4], out=sel0c4);
    Nand(a=sel[0], b=d[4], out=sel0d4);
    Nand(a=sel0c4, b=sel0d4, out=outSel0cd4);

    Nand(a=sel1, b=outSel0ab4, out=sel1ab4);
    Nand(a=sel[1], b=outSel0cd4, out=sel1cd4);
    Nand(a=sel1ab4, b=sel1cd4, out=out[4]);

    // bit 5
    Nand(a=sel0, b=a[5], out=sel0a5);
    Nand(a=sel[0], b=b[5], out=sel0b5);
    Nand(a=sel0a5, b=sel0b5, out=outSel0ab5);

    Nand(a=sel0, b=c[5], out=sel0c5);
    Nand(a=sel[0], b=d[5], out=sel0d5);
    Nand(a=sel0c5, b=sel0d5, out=outSel0cd5);

    Nand(a=sel1, b=outSel0ab5, out=sel1ab5);
    Nand(a=sel[1], b=outSel0cd5, out=sel1cd5);
    Nand(a=sel1ab5, b=sel1cd5, out=out[5]);

    // bit 6
    Nand(a=sel0, b=a[6], out=sel0a6);
    Nand(a=sel[0], b=b[6], out=sel0b6);
    Nand(a=sel0a6, b=sel0b6, out=outSel0ab6);

    Nand(a=sel0, b=c[6], out=sel0c6);
    Nand(a=sel[0], b=d[6], out=sel0d6);
    Nand(a=sel0c6, b=sel0d6, out=outSel0cd6);

    Nand(a=sel1, b=outSel0ab6, out=sel1ab6);
    Nand(a=sel[1], b=outSel0cd6, out=sel1cd6);
    Nand(a=sel1ab6, b=sel1cd6, out=out[6]);

    // bit 7
    Nand(a=sel0, b=a[7], out=sel0a7);
    Nand(a=sel[0], b=b[7], out=sel0b7);
    Nand(a=sel0a7, b=sel0b7, out=outSel0ab7);

    Nand(a=sel0, b=c[7], out=sel0c7);
    Nand(a=sel[0], b=d[7], out=sel0d7);
    Nand(a=sel0c7, b=sel0d7, out=outSel0cd7);

    Nand(a=sel1, b=outSel0ab7, out=sel1ab7);
    Nand(a=sel[1], b=outSel0cd7, out=sel1cd7);
    Nand(a=sel1ab7, b=sel1cd7, out=out[7]);

    // bit 8
    Nand(a=sel0, b=a[8], out=sel0a8);
    Nand(a=sel[0], b=b[8], out=sel0b8);
    Nand(a=sel0a8, b=sel0b8, out=outSel0ab8);

    Nand(a=sel0, b=c[8], out=sel0c8);
    Nand(a=sel[0], b=d[8], out=sel0d8);
    Nand(a=sel0c8, b=sel0d8, out=outSel0cd8);

    Nand(a=sel1, b=outSel0ab8, out=sel1ab8);
    Nand(a=sel[1], b=outSel0cd8, out=sel1cd8);
    Nand(a=sel1ab8, b=sel1cd8, out=out[8]);

    // bit 9
    Nand(a=sel0, b=a[9], out=sel0a9);
    Nand(a=sel[0], b=b[9], out=sel0b9);
    Nand(a=sel0a9, b=sel0b9, out=outSel0ab9);

    Nand(a=sel0, b=c[9], out=sel0c9);
    Nand(a=sel[0], b=d[9], out=sel0d9);
    Nand(a=sel0c9, b=sel0d9, out=outSel0cd9);

    Nand(a=sel1, b=outSel0ab9, out=sel1ab9);
    Nand(a=sel[1], b=outSel0cd9, out=sel1cd9);
    Nand(a=sel1ab9, b=sel1cd9, out=out[9]);

    // bit 10
    Nand(a=sel0, b=a[10], out=sel0a10);
    Nand(a=sel[0], b=b[10], out=sel0b10);
    Nand(a=sel0a10, b=sel0b10, out=outSel0ab10);

    Nand(a=sel0, b=c[10], out=sel0c10);
    Nand(a=sel[0], b=d[10], out=sel0d10);
    Nand(a=sel0c10, b=sel0d10, out=outSel0cd10);

    Nand(a=sel1, b=outSel0ab10, out=sel1ab10);
    Nand(a=sel[1], b=outSel0cd10, out=sel1cd10);
    Nand(a=sel1ab10, b=sel1cd10, out=out[10]);

    // bit 11
    Nand(a=sel0, b=a[11], out=sel0a11);
    Nand(a=sel[0], b=b[11], out=sel0b11);
    Nand(a=sel0a11, b=sel0b11, out=outSel0ab11);

    Nand(a=sel0, b=c[11], out=sel0c11);
    Nand(a=sel[0], b=d[11], out=sel0d11);
    Nand(a=sel0c11, b=sel0d11, out=outSel0cd11);

    Nand(a=sel1, b=outSel0ab11, out=sel1ab11);
    Nand(a=sel[1], b=outSel0cd11, out=sel1cd11);
    Nand(a=sel1ab11, b=sel1cd11, out=out[11]);

    // bit 12
    Nand(a=sel0, b=a[12], out=sel0a12);
    Nand(a=sel[0], b=b[12], out=sel0b12);
    Nand(a=sel0a12, b=sel0b12, out=outSel0ab12);

    Nand(a=sel0, b=c[12], out=sel0c12);
    Nand(a=sel[0], b=d[12], out=sel0d12);
    Nand(a=sel0c12, b=sel0d12, out=outSel0cd12);

    Nand(a=sel1, b=outSel0ab12, out=sel1ab12);
    Nand(a=sel[1], b=outSel0cd12, out=sel1cd12);
    Nand(a=sel1ab12, b=sel1cd12, out=out[12]);

    // bit 13
    Nand(a=sel0, b=a[13], out=sel0a13);
    Nand(a=sel[0], b=b[13], out=sel0b13);
    Nand(a=sel0a13, b=sel0b13, out=outSel0ab13);

    Nand(a=sel0, b=c[13], out=sel0c13);
    Nand(a=sel[0], b=d[13], out=sel0d13);
    Nand(a=sel0c13, b=sel0d13, out=outSel0cd13);

    Nand(a=sel1, b=outSel0ab13, out=sel1ab13);
    Nand(a=sel[1], b=outSel0cd13, out=sel1cd13);
    Nand(a=sel1ab13, b=sel1cd13, out=out[13]);

    // bit 14
    Nand(a=sel0, b=a[14], out=sel0a14);
    Nand(a=sel[0], b=b[14], out=sel0b14);
    Nand(a=sel0a14, b=sel0b14, out=outSel0ab14);

    Nand(a=sel0, b=c[14], out=sel0c14);
    Nand(a=sel[0], b=d[14], out=sel0d14);
    Nand(a=sel0c14, b=sel0d14, out=outSel0cd14);

    Nand(a=sel1, b=outSel0ab14, out=sel1ab14);
    Nand(a=sel[1], b=outSel0cd14, out=sel1cd14);
    Nand(a=sel1ab14, b=sel1cd14, out=out[14]);

    // bit 15
    Nand(a=sel0, b=a[15], out=sel0a15);
    Nand(a=sel[0], b=b[15], out=sel0b15);
    Nand(a=sel0a15, b=sel0b15, out=outSel0ab15);

    Nand(a=sel0, b=c[15], out=sel0c15);
    Nand(a=sel[0], b=d[15], out=sel0d15);
    Nand(a=sel0c15, b=sel0d15, out=outSel0cd15);

    Nand(a=sel1, b=outSel0ab15, out=sel1ab15);
    Nand(a=sel[1], b=outSel0cd15, out=sel1cd15);
    Nand(a=sel1ab15, b=sel1cd15, out=out[15]);
}
