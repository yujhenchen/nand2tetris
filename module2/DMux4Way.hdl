CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    // NOT gates
    Nand(a=sel[0], b=sel[0], out=notSel0);
    Nand(a=sel[1], b=sel[1], out=notSel1);

    // a = in & !sel1 & !sel0
    Nand(a=in, b=notSel1, out=x1);
    Nand(a=x1, b=x1, out=y1);
    Nand(a=y1, b=notSel0, out=x2);
    Nand(a=x2, b=x2, out=a);

    // b = in & !sel1 & sel0
    Nand(a=in, b=notSel1, out=x3);
    Nand(a=x3, b=x3, out=y2);
    Nand(a=y2, b=sel[0], out=x4);
    Nand(a=x4, b=x4, out=b);

    // c = in & sel1 & !sel0
    Nand(a=in, b=sel[1], out=x5);
    Nand(a=x5, b=x5, out=y3);
    Nand(a=y3, b=notSel0, out=x6);
    Nand(a=x6, b=x6, out=c);

    // d = in & sel1 & sel0
    Nand(a=in, b=sel[1], out=x7);
    Nand(a=x7, b=x7, out=y4);
    Nand(a=y4, b=sel[0], out=x8);
    Nand(a=x8, b=x8, out=d);
}
